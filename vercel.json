{
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],

  "outputDirectory": "static",

  "rewrites": [
    { "source": "/(.*)", "destination": "/app.py" }
  ],

  "headers": [
    {
      "source": "/cron/verificar_chamados",
      "headers": [
        {
          "key": "X-CRON-TOKEN",
          "value": "allowed"
        }
      ]
    }
  ],

  "build": {
    "env": {
      "PYTHON_VERSION": "3.10"
    }
  }
}
